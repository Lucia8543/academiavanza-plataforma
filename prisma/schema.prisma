generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["app", "catalogo"]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model accesos {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profesor_id String     @db.Uuid
  token_hash  String     @unique
  proposito   String     @default("acceso")
  expira_en   DateTime   @db.Timestamptz(6)
  usado_en    DateTime?  @db.Timestamptz(6)
  creado_en   DateTime   @default(now()) @db.Timestamptz(6)
  profesores  profesores @relation(fields: [profesor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expira_en], map: "idx_accesos_purga")
  @@index([token_hash], map: "idx_accesos_token")
  @@schema("app")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model contactos {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profesor_id          String           @db.Uuid
  nombre_familia       String
  email_familia        String?          @db.Citext
  telefono_familia     String?
  nivel_id             String?          @db.Uuid
  mensaje              String?
  es_tutor_legal       Boolean          @default(false)
  acepta_privacidad    Boolean          @default(false)
  enviado_en           DateTime         @default(now()) @db.Timestamptz(6)
  estado               estado_solicitud @default(pendiente_profesor)
  codigo               String           @unique(map: "contacto_codigo_unico")
  token_familia        String           @unique(map: "contacto_token_fam_unico")
  token_profesor       String           @unique(map: "contacto_token_pro_unico")
  aceptada_en          DateTime?        @db.Timestamptz(6)
  rechazada_en         DateTime?        @db.Timestamptz(6)
  pagada_en            DateTime?        @db.Timestamptz(6)
  motivo_rechazo       String?
  importe              Decimal?         @db.Decimal(8, 2)
  vale_concedido       Boolean          @default(false)
  vale_de              String?          @db.Uuid
  avisado_push         Boolean          @default(false)
  avisado_correo       Boolean          @default(false)
  motivo_vale          String?
  vale_pedido_en       DateTime?        @db.Timestamptz(6)
  recordatorio_pago_en DateTime?        @db.Timestamptz(6)
  intencion_pago       String?
  cancelada_en         DateTime?        @db.Timestamptz(6)
  devuelta_en          DateTime?        @db.Timestamptz(6)
  importe_devuelto     Decimal?         @db.Decimal(8, 2)
  motivo_devolucion    String?
  aviso_vale_caduca_en DateTime?        @db.Timestamptz(6)
  motivo_cierre        String?
  motivo_cierre_en     DateTime?        @db.Timestamptz(6)
  pago_avisado_en      DateTime?        @db.Timestamptz(6)
  vale_caduca_en       DateTime?        @db.Timestamptz(6)
  recordatorios_profesor   Int          @default(0) @db.SmallInt
  recordatorio_profesor_en DateTime?    @db.Timestamptz(6)
  urgencia                 String       @default("ya")
  niveles              niveles?         @relation(fields: [nivel_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  profesores           profesores       @relation(fields: [profesor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  contactos            contactos?       @relation("contactosTocontactos", fields: [vale_de], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_contactos      contactos[]      @relation("contactosTocontactos")

  @@index([enviado_en], map: "idx_contactos_fecha")
  @@index([profesor_id, enviado_en(sort: Desc)], map: "idx_contactos_profesor")
  @@index([estado, enviado_en], map: "idx_contactos_estado")
  @@index([profesor_id, motivo_vale], map: "idx_contactos_vales", where: raw("(motivo_vale IS NOT NULL)"))
  @@index([estado, aceptada_en], map: "idx_contactos_pago_pendiente", where: raw("(estado = 'aceptada'::app.estado_solicitud)"))
  @@index([enviado_en], map: "idx_contactos_vale_vivo", where: raw("(vale_concedido AND (aviso_vale_caduca_en IS NULL))"))
  @@index([profesor_id, motivo_cierre_en(sort: Desc)], map: "idx_contactos_motivo_cierre", where: raw("(motivo_cierre IS NOT NULL)"))
  @@index([pago_avisado_en], map: "idx_contactos_pago_avisado", where: raw("((pago_avisado_en IS NOT NULL) AND (estado = 'aceptada'::app.estado_solicitud))"))
  @@index([vale_caduca_en], map: "idx_contactos_vale_caduca", where: raw("(vale_concedido AND (vale_caduca_en IS NOT NULL))"))
  @@index([enviado_en], map: "idx_contactos_esperando_profesor", where: raw("(estado = 'pendiente_profesor'::app.estado_solicitud)"))
  @@schema("app")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model profesor_asignaturas {
  profesor_id   String      @db.Uuid
  asignatura_id String      @db.Uuid
  asignaturas   asignaturas @relation(fields: [asignatura_id], references: [id], onUpdate: NoAction)
  profesores    profesores  @relation(fields: [profesor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([profesor_id, asignatura_id])
  @@schema("app")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model profesor_certificaciones {
  profesor_id            String                 @db.Uuid
  certificacion_id       String                 @db.Uuid
  certificaciones_idioma certificaciones_idioma @relation(fields: [certificacion_id], references: [id], onUpdate: NoAction)
  profesores             profesores             @relation(fields: [profesor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([profesor_id, certificacion_id])
  @@schema("app")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model profesor_disponibilidad {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profesor_id String     @db.Uuid
  dia_semana  Int        @db.SmallInt
  hora_inicio DateTime   @db.Time(6)
  hora_fin    DateTime   @db.Time(6)
  profesores  profesores @relation(fields: [profesor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([profesor_id, dia_semana, hora_inicio], map: "disp_franja_unica")
  @@index([profesor_id], map: "idx_disponibilidad_profesor")
  @@schema("app")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model profesor_niveles {
  profesor_id String     @db.Uuid
  nivel_id    String     @db.Uuid
  niveles     niveles    @relation(fields: [nivel_id], references: [id], onUpdate: NoAction)
  profesores  profesores @relation(fields: [profesor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([profesor_id, nivel_id])
  @@schema("app")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model profesores {
  id                           String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                         String                     @unique
  nombre                       String
  apellidos                    String
  email                        String                     @unique @db.Citext
  colegio_id                   String?                    @db.Uuid
  colegio_otro                 String?
  titulacion                   String?
  universidad                  String?
  curso_actual                 Int?                       @db.SmallInt
  titulacion_finalizada        Boolean                    @default(false)
  puntos_fuertes               String?
  modalidad                    modalidad                  @default(online)
  zona_otra                    String?
  estado                       estado_profesor            @default(pendiente)
  disponible                   Boolean                    @default(true)
  disponibilidad_confirmada_en DateTime                   @default(now()) @db.Timestamptz(6)
  ultimo_recordatorio_en       DateTime?                  @db.Timestamptz(6)
  enlace_reenviado_en          DateTime?                  @db.Timestamptz(6)
  pausada_auto_en              DateTime?                  @db.Timestamptz(6)
  aprobado_en                  DateTime?                  @db.Timestamptz(6)
  motivo_rechazo               String?
  acepta_publicacion           Boolean                    @default(false)
  acepta_publicacion_en        DateTime?                  @db.Timestamptz(6)
  version_privacidad           String?
  creado_en                    DateTime                   @default(now()) @db.Timestamptz(6)
  actualizado_en               DateTime                   @default(now()) @db.Timestamptz(6)
  telefono                     String?
  anos_experiencia             Int?                       @db.SmallInt
  desplazamiento_flexible      Boolean                    @default(false)
  cupo                         String                     @default("busca")
  accesos                      accesos[]
  contactos                    contactos[]
  profesor_asignaturas         profesor_asignaturas[]
  profesor_certificaciones     profesor_certificaciones[]
  profesor_disponibilidad      profesor_disponibilidad[]
  profesor_niveles             profesor_niveles[]
  colegios                     colegios?                  @relation(fields: [colegio_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  suscripciones_push           suscripciones_push[]

  @@index([colegio_id], map: "idx_profesores_colegio")
  @@index([estado, disponible], map: "idx_profesores_directorio", where: raw("((estado = 'activo'::app.estado_profesor) AND disponible)"))
  @@index([email], map: "idx_profesores_email")
  @@index([cupo], map: "idx_profesores_cupo", where: raw("((estado = 'activo'::app.estado_profesor) AND disponible)"))
  @@schema("app")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
/// Caja negra del proceso diario: cuándo corrió y qué falló.
model mantenimiento_ejecuciones {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ejecutado_en DateTime @default(now()) @db.Timestamptz(6)
  resumen      Json
  errores      String[] @default([])
  duracion_ms  Int?

  @@index([ejecutado_en(sort: Desc)], map: "idx_mantenimiento_ultima")
  @@schema("app")
}

model incidencias {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quien       String    @default("visita")
  texto       String
  pagina      String?
  email       String?
  estado      String    @default("nueva")
  creado_en   DateTime  @default(now()) @db.Timestamptz(6)
  resuelto_en DateTime? @db.Timestamptz(6)

  @@index([creado_en(sort: Desc)], map: "idx_incidencias_pendientes", where: raw("(estado <> 'resuelta'::text)"))
  @@schema("app")
}

model tarifas {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  concepto          String    @default("match")
  importe           Decimal   @db.Decimal(8, 2)
  moneda            String    @default("EUR") @db.Char(3)
  vigente_desde     DateTime  @default(now()) @db.Timestamptz(6)
  vigente_hasta     DateTime? @db.Timestamptz(6)
  stripe_price_id   String?
  stripe_product_id String?
  motivo            String?
  creado_en         DateTime  @default(now()) @db.Timestamptz(6)

  @@schema("app")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model asignaturas {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                 String                 @unique
  nombre               String                 @unique
  categoria            String?
  icono                String?
  orden_visual         Int                    @default(100)
  activa               Boolean                @default(true)
  creado_en            DateTime               @default(now()) @db.Timestamptz(6)
  profesor_asignaturas profesor_asignaturas[]

  @@index([activa, orden_visual], map: "idx_asignaturas_activa", where: raw("activa"))
  @@schema("catalogo")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model certificaciones_idioma {
  id                       String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                     String                     @unique
  idioma                   String
  nombre                   String
  nivel_mcer               String?
  organismo                String?
  orden_visual             Int                        @default(100)
  activa                   Boolean                    @default(true)
  profesor_certificaciones profesor_certificaciones[]

  @@schema("catalogo")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model colegios {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug           String       @unique
  nombre         String
  nombre_corto   String?
  logo_url       String?
  web_url        String?
  municipio      String?
  provincia      String?      @default("Madrid")
  destacado      Boolean      @default(false)
  orden_visual   Int          @default(100)
  activo         Boolean      @default(true)
  creado_en      DateTime     @default(now()) @db.Timestamptz(6)
  actualizado_en DateTime     @default(now()) @db.Timestamptz(6)
  profesores     profesores[]

  @@index([activo, orden_visual], map: "idx_colegios_activo", where: raw("activo"))
  @@schema("catalogo")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model niveles {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug              String             @unique
  nombre            String             @unique
  etapa             etapa_educativa
  orden_visual      Int
  activo            Boolean            @default(true)
  creado_en         DateTime           @default(now()) @db.Timestamptz(6)
  precio_referencia Decimal?           @db.Decimal(6, 2)
  contactos         contactos[]
  profesor_niveles  profesor_niveles[]

  @@index([etapa, orden_visual], map: "idx_niveles_etapa", where: raw("activo"))
  @@schema("catalogo")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model suscripciones_push {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profesor_id  String     @db.Uuid
  endpoint     String     @unique
  p256dh       String
  auth         String
  creado_en    DateTime   @default(now()) @db.Timestamptz(6)
  usado_en     DateTime?  @db.Timestamptz(6)
  fallo_en     DateTime?  @db.Timestamptz(6)
  motivo_fallo String?
  profesores   profesores @relation(fields: [profesor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([profesor_id], map: "idx_push_profesor", where: raw("(fallo_en IS NULL)"))
  @@schema("app")
}

enum estado_profesor {
  pendiente
  activo
  pausado
  inactivo
  rechazado

  @@schema("app")
}

enum modalidad {
  online
  presencial
  ambas

  @@schema("app")
}

enum etapa_educativa {
  primaria
  eso
  bachillerato
  evau
  universidad
  otros

  @@schema("catalogo")
}

enum estado_solicitud {
  pendiente_profesor
  aceptada
  pagada
  rechazada
  caducada
  cancelada
  devuelta

  @@schema("app")
}
