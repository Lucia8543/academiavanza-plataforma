# =============================================================================
# AcademiAvanza — Variables de entorno
# =============================================================================
# Copia este fichero a .env.local y rellena los valores reales.
# .env.local está en .gitignore y NUNCA debe subirse al repositorio.
# =============================================================================

# -----------------------------------------------------------------------------
# Aplicación
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# -----------------------------------------------------------------------------
# Supabase
# Panel de Supabase → Project Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio: omite la seguridad por fila. Sólo en servidor, nunca
# en código que llegue al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Base de datos
# Panel de Supabase → Project Settings → Database
#
# DATABASE_URL usa el pool de conexiones (puerto 6543), para la aplicación.
# DIRECT_URL usa la conexión directa (puerto 5432), para migraciones.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://academiavanza_app:CLAVE@db.xxxx.supabase.co:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://academiavanza_app:CLAVE@db.xxxx.supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# Stripe
# Panel de Stripe → Developers → API keys
# En desarrollo, usa siempre las claves de prueba (pk_test_ / sk_test_)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_SECRET_KEY=sk_test_

# Secreto del webhook. En local se obtiene con:
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_

# -----------------------------------------------------------------------------
# Resend (correo electrónico)
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_
EMAIL_REMITENTE="AcademiAvanza <hola@academiavanza.es>"
EMAIL_ADMIN=

# -----------------------------------------------------------------------------
# WATI (WhatsApp Business API)
# Dejar WHATSAPP_ACTIVO=false en desarrollo para no gastar mensajes reales.
# -----------------------------------------------------------------------------
WATI_API_URL=https://live-server-xxxxx.wati.io
WATI_ACCESS_TOKEN=
WHATSAPP_ACTIVO=false

# -----------------------------------------------------------------------------
# Observabilidad (opcional en desarrollo)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=academiavanza.es
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# Procesos programados
# Cadena aleatoria que protege los endpoints de tareas programadas para que no
# los pueda invocar cualquiera. Genera una con: openssl rand -hex 32
# -----------------------------------------------------------------------------
CRON_SECRET=
