# =============================================================================
# AcademiAvanza — Variables de entorno
# =============================================================================
# Copia este fichero a .env.local y rellena los valores reales.
# .env.local está en .gitignore y NUNCA debe subirse al repositorio.
# =============================================================================

# -----------------------------------------------------------------------------
# Aplicación
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# -----------------------------------------------------------------------------
# Supabase
# Panel de Supabase → Project Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio: omite la seguridad por fila. Sólo en servidor, nunca
# en código que llegue al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Base de datos
# Panel de Supabase → Project Settings → Database
#
# DATABASE_URL usa el pool de conexiones (puerto 6543), para la aplicación.
# DIRECT_URL usa la conexión directa (puerto 5432), para migraciones.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://academiavanza_app:CLAVE@db.xxxx.supabase.co:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://academiavanza_app:CLAVE@db.xxxx.supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# Panel de administración
#
# ADMIN_CLAVE     la contraseña para entrar en /admin
# ADMIN_SECRETO   cadena larga y aleatoria con la que se firma la sesión.
#                 Cambiarla cierra la sesión en todos los dispositivos.
#
# Genera el secreto con:
#   -join ((48..57)+(97..122) | Get-Random -Count 48 | % {[char]$_})
#
# CUIDADO CON LA ALMOHADILLA. En este fichero, un valor sin comillas se corta
# en el primer `#`: todo lo que va detrás se considera un comentario. Una
# contraseña como 3J#g6SSp llega al servidor convertida en 3J. Si el valor
# lleva #, comillas o espacios, escríbelo entre comillas dobles:
#   ADMIN_CLAVE="cuchara#tejado melon"
# -----------------------------------------------------------------------------
ADMIN_CLAVE=
ADMIN_SECRETO=

# -----------------------------------------------------------------------------
# Cobro del match (ADR 0006)
#
# Teléfono al que las familias hacen el Bizum. Se enseña en pantalla a quien
# llegue al paso del pago, así que no es un secreto, pero vive aquí y no en el
# código para poder cambiarlo sin desplegar.
#
# Si se deja vacío, la pantalla enseña el código pero no el número.
#
# El PRECIO no está aquí: vive en la tabla app.tarifas y se cambia desde el
# panel, en /admin/cobros.
# -----------------------------------------------------------------------------
BIZUM_TELEFONO=

# -----------------------------------------------------------------------------
# Stripe
# Panel de Stripe → Developers → API keys
# En desarrollo, usa siempre las claves de prueba (pk_test_ / sk_test_)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_SECRET_KEY=sk_test_

# Secreto del webhook. En local se obtiene con:
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_

# -----------------------------------------------------------------------------
# Resend (correo electrónico)
#
# Mientras estas dos estén vacías NO SE ENVÍA NINGÚN CORREO. La aplicación
# funciona igual: los mensajes de las familias se guardan y aparecen en el panel
# con el aviso de «sin avisar», para poder escribir a mano. En cuanto haya un
# dominio verificado en Resend, se rellenan aquí y en Vercel y los avisos
# empiezan a salir solos, sin tocar código.
#
# EMAIL_REMITENTE tiene que usar un dominio verificado en Resend. Con uno sin
# verificar, Resend rechaza el envío.
# -----------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_REMITENTE="AcademiAvanza <hola@academiavanza.es>"
EMAIL_ADMIN=

# -----------------------------------------------------------------------------
# WATI (WhatsApp Business API)
# Dejar WHATSAPP_ACTIVO=false en desarrollo para no gastar mensajes reales.
# -----------------------------------------------------------------------------
WATI_API_URL=https://live-server-xxxxx.wati.io
WATI_ACCESS_TOKEN=
WHATSAPP_ACTIVO=false

# -----------------------------------------------------------------------------
# Observabilidad (opcional en desarrollo)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=academiavanza.es
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# Tareas automáticas
#
# Vercel llama todos los días a /api/mantenimiento, y esta cadena es lo que
# demuestra que la llamada viene de Vercel y no de cualquiera. Vercel la manda
# sola en la cabecera Authorization en cuanto la variable existe: no hay que
# escribir código para eso.
#
# Sin ella, las tareas no corren. Es deliberado: es preferible que no se
# ejecuten y se note, a que las pueda disparar quien pase por ahí.
#
# Genera una con:
#   -join ((48..57)+(97..122) | Get-Random -Count 48 | % {[char]$_})
#
# Ojo con el plan gratuito de Vercel: las tareas sólo pueden correr una vez al
# día y a la hora aproximada, no al minuto exacto.
# -----------------------------------------------------------------------------
CRON_SECRET=
